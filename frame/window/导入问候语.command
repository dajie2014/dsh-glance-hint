#!/bin/bash
# 双击这个文件 —— 打开那个文件夹，把**你自己的**问候录音拖进去。
#
# 拖着放着就行：格式随便（wav / mp3 / m4a / aiff），文件名也不用改。
# 拖完再双击一次「阿达」或者「开机自启」，那句问候就换成你的声音了。
#
# 为什么要有这么个入口：这东西默认是**静音打招呼**的 —— 画面照常挥手、气泡照常弹，
# 只是不说话（总不能替别人决定用什么声音）。想让它开口，就自己放一段。

set -uo pipefail
LIB="${HOME}/Library/Application Support/GlanceHint"
DIR="${LIB}/voice"
mkdir -p "${DIR}"
open "${DIR}"

cat <<EOF

把你的问候录音拖进刚打开的那个文件夹：

    ${DIR}

· 格式随便：wav / mp3 / m4a / aiff 都认
· 文件名也不用改，拖进去就行
· 那个文件夹里已经有音频的话，先把它拖走（不然用的还是旧的那个）
· 拖完双击一次「阿达」（或者「开机自启」），就换上了

想马上听效果：把 DSH 关掉再打开，阿达出来打招呼时就是你的声音。

EOF
read -r -p "按回车关掉这个窗口"
